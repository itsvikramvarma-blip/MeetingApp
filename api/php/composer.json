{
  "name": "meeting-app/php-api",
  "description": "Meeting App PHP API with JWT auth, meetings, tasks, and meeting minutes",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.0",
    "firebase/php-jwt": "^6.4",
    "vlucas/phpdotenv": "^5.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "scripts": {
    "start": "php -S 0.0.0.0:8080 -t public",
    "test": "phpunit"
  }
